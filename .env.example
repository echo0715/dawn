OPENAI_API_KEY=none
TIMEOUT_ScreenshotEvent=120
TIMEOUT_BrowserStateRequestEvent=120

# LLM configuration
# Model name to use (default: gpt-4.1-mini)
# LLM_MODEL=gpt-5.4
LLM_MODEL=Qwen/Qwen3.6-35B-A3B
# Base URL for the OpenAI-compatible API. Leave unset to use OpenAI's default.
# For a local vLLM server: LLM_BASE_URL=http://localhost:8000/v1
LLM_BASE_URL=http://localhost:8000/v1
# Send a screenshot each step in addition to the DOM/AX tree (requires a vision-capable model)
LLM_USE_VISION=true

# When true, write per-step observation/action/screenshot logs into logs/{datetime}/{run_id}/
VERBOSE_LOGGING=false
